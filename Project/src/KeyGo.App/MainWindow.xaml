<Window x:Class="KeyGo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KeyGo.App.ViewModels"
        Title="KeyGo" Width="1440" Height="900" MinWidth="1050" MinHeight="650"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <Grid Margin="38,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="WELCOME BACK" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                <StackPanel Grid.Row="1" Margin="0,10,0,28"><TextBlock Text="One AI, your way." FontSize="34" FontWeight="SemiBold"/><TextBlock Text="A local-first workspace for understanding and changing real projects." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,5,0,0"/></StackPanel>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24" Margin="0,0,12,0"><StackPanel><TextBlock Text="CURRENT PROJECT" Style="{StaticResource Caption}"/><TextBlock Text="Open a project to activate the workspace" FontSize="20" Margin="0,12,0,22"/><Button Content="Open Project" Command="{Binding OpenProjectCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24" Margin="12,0,0,0"><StackPanel><TextBlock Text="CONNECTED AI" Style="{StaticResource Caption}"/><TextBlock Text="Connect a provider locally" FontSize="20" Margin="0,12,0,8"/><TextBlock Text="KeyGo sends context directly to your selected provider. Credentials remain in the local credential manager abstraction." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><Button Content="New Chat" Command="{Binding NewChatCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel></Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><StackPanel><TextBlock Text="PROJECT EXPLORER" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding ProjectName}" FontSize="28" FontWeight="SemiBold"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Open Folder" Command="{Binding OpenProjectCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18"/>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><ListView ItemsSource="{Binding Files}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"><ListView.View><GridView><GridViewColumn Header="PATH" DisplayMemberBinding="{Binding RelativePath}" Width="520"/><GridViewColumn Header="KIND" DisplayMemberBinding="{Binding Kind}" Width="130"/><GridViewColumn Header="LINES" DisplayMemberBinding="{Binding LineCount}" Width="100"/></GridView></ListView.View></ListView></Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProvidersViewModel}">
            <Grid Margin="30"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0"><TextBlock Text="AI PROVIDERS" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Bring your own key" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,22"/><ItemsControl ItemsSource="{Binding ProviderCards}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayName}" Tag="{Binding}" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="ProviderButton_Click"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="26"><StackPanel><TextBlock Text="CONNECTION INSPECTOR" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding SelectedProvider.DisplayName}" FontSize="26" Margin="0,7,0,5"/><TextBlock Text="{Binding SelectedProvider.Status}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,24"/><TextBlock Text="API KEY" Style="{StaticResource Caption}"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged" Margin="0,7,0,16"/><Button Content="Verify and discover models" Command="{Binding VerifyCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,0"/><Separator Margin="0,22,0,18"/><TextBlock Text="DISCOVERED MODELS" Style="{StaticResource Caption}"/><ItemsControl ItemsSource="{Binding Models}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock Text="{Binding DisplayName}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="AI WORKSPACE" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Chat with your project" FontSize="28" FontWeight="SemiBold"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock Text="Privacy" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox IsChecked="{Binding IsCloud}" Content="CLOUD" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName" Width="190" Margin="18,0,0,0"/></StackPanel></DockPanel>
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding IsAssistant, Converter={StaticResource AssistantBrushConverter}}" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
                <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54" MaxHeight="120" VerticalScrollBarVisibility="Auto" ToolTip="Ctrl+Enter to send"/><Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" Visibility="{Binding ShowStop, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource SecondaryButton}" Margin="10,0,8,0"/><Button Grid.Column="2" Content="Send" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}"/></Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AgentViewModel}">
            <Grid Margin="30"><TextBlock Text="AGENT" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Read-only investigation" FontSize="28" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBox Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,62,0,12"/><Button Content="Start investigation" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,12"/><ItemsControl ItemsSource="{Binding Activity}"/></Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InfoPageViewModel}">
            <StackPanel Margin="38"><TextBlock Text="{Binding Eyebrow}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,14"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="15" TextWrapping="Wrap" MaxWidth="620"/></StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="24,0"><TextBlock Text="KEYGO" FontSize="21" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text="One AI, your way." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,22,0"/><TextBlock Text="{Binding ModelLabel}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,22,0"/><TextBlock Text="{Binding PrivacyLabel}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><StackPanel Margin="12,22"><TextBlock Text="WORKSPACE" Style="{StaticResource Caption}" Margin="14,0,0,12"/><Button Content="Home" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource NavButton}"/><Button Content="Chat" Command="{Binding NavigateCommand}" CommandParameter="Chat" Style="{StaticResource NavButton}"/><Button Content="Agent" Command="{Binding NavigateCommand}" CommandParameter="Agent" Style="{StaticResource NavButton}"/><Button Content="Projects" Command="{Binding NavigateCommand}" CommandParameter="Projects" Style="{StaticResource NavButton}"/><TextBlock Text="SYSTEM" Style="{StaticResource Caption}" Margin="14,28,0,12"/><Button Content="Providers" Command="{Binding NavigateCommand}" CommandParameter="Providers" Style="{StaticResource NavButton}"/><Button Content="Models" Command="{Binding NavigateCommand}" CommandParameter="Models" Style="{StaticResource NavButton}"/><Button Content="Usage &amp; Costs" Command="{Binding NavigateCommand}" CommandParameter="Usage" Style="{StaticResource NavButton}"/><Button Content="Security" Command="{Binding NavigateCommand}" CommandParameter="Security" Style="{StaticResource NavButton}"/><Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavButton}"/></StackPanel></Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"><StackPanel Margin="22,28"><TextBlock Text="INSPECTOR" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Context" FontSize="18" Margin="0,18,0,4"/><TextBlock Text="Selected project context appears before a cloud request." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><Separator Margin="0,22,0,18"/><TextBlock Text="STATUS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Chat.Status}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/><Separator Margin="0,22,0,18"/><TextBlock Text="PRIVACY" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PrivacyLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource AccentDarkBrush}"><DockPanel Margin="20,0"><TextBlock Text="●  Ready" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="24,0,0,0"/><TextBlock Text="{Binding Chat.Status}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel></Border>
    </Grid>
</Window>